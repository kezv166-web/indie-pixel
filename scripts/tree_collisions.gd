func _ready() -> void:
	_create_tree_colliders()

func _create_tree_colliders() -> void:
	# Single shared RectangleShape2D resource for optimal physics engine memory and performance
	var shared_box := RectangleShape2D.new()
	shared_box.size = TRUNK_HITBOX_SIZE
	
	for tree_pos in TREE_POSITIONS:
		var col := CollisionShape2D.new()
		col.shape = shared_box
		col.position = tree_pos
		add_child(col)
	
	print("Spawned GBA rectangular trunk hitboxes for ", TREE_POSITIONS.size(), " trees across the map.")
